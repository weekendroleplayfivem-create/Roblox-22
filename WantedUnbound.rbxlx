	class: string,
	price: number,
	maxSpeed: number, -- studs/s
	accel: number, -- studs/s^2
	brake: number,
	turn: number, -- rad/s at full lock
	grip: number, -- lateral grip (higher = less slide)
	nitroMult: number,
	color: Color3,
	style: string, -- body shape: "coupe" | "muscle" | "hyper" | "suv"
	blacklistOnly: boolean?,
}

