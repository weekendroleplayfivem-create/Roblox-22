end

---------------------------------------------------------------------------
-- Misc world features
---------------------------------------------------------------------------
-- Speed cameras: {i, j, axis} placed mid-road. axis "x" = road runs along X.
Config.SpeedCameras = {
	{ i = 2, j = 4, axis = "x" },
	{ i = 6, j = 1, axis = "z" },
	{ i = 4, j = 7, axis = "x" },
	{ i = 0, j = 5, axis = "z" },
}
Config.SpeedCameraCashPerMph = 25

-- Pursuit breakers placed on block corners next to these intersections.
